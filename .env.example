# Le lien QuillForms du questionnaire est centralisé dans lib/content.ts via site.questionnaireUrl.

# Pré-inscriptions : jeton du store Vercel Blob (ajouté automatiquement par Vercel
# quand le store est relié au projet ; en local : `vercel env pull .env.local`).
BLOB_READ_WRITE_TOKEN=

# Mot de passe de l'espace admin /admin (liste et export des pré-inscriptions).
ADMIN_PASSWORD=

# Optionnel, en local : simuler une autre date d'ouverture des pré-inscriptions.
# PREINSCRIPTION_OPENS_AT=2026-09-01T00:00:00-04:00
