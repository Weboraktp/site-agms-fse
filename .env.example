# Pré-inscriptions : store Vercel Blob privé (Paris), relié au projet agmsmed.
# Vercel ajoute BLOB_STORE_ID ; sur Vercel, l'accès passe par le jeton OIDC fourni
# à chaque requête. En local : `vercel env pull .env.local` (ajoute VERCEL_OIDC_TOKEN).
BLOB_STORE_ID=

# Mot de passe de l'espace admin /admin (liste et export des pré-inscriptions).
ADMIN_PASSWORD=

# Optionnel, en local : simuler une autre date d'ouverture des pré-inscriptions.
# PREINSCRIPTION_OPENS_AT=2026-09-01T00:00:00-04:00

# Cockpit de l'AGMS (outil de gestion interne) : chaque demande d'inscription lui est transmise
# après son enregistrement, et c'est lui qui prévient l'équipe par e-mail. Côté serveur uniquement.
# COCKPIT_URL : adresse du cockpit, en https, sans chemin. COCKPIT_WEBHOOK_KEY : la même valeur
# que SITE_WEBHOOK_KEY côté cockpit. Absentes : rien n'est transmis. À poser en Production
# seulement (les essais en local ou en preview ne partent jamais au cockpit).
COCKPIT_URL=
COCKPIT_WEBHOOK_KEY=

# Rattrapage quotidien des demandes non arrivées au cockpit (vercel.json, /api/cron/cockpit) :
# Vercel signe son appel avec cette valeur. Une longue chaîne aléatoire, en Production seulement.
# Absente : la route reste fermée et rien n'est renvoyé automatiquement (le bouton de /admin reste).
CRON_SECRET=
