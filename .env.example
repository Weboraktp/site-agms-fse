# Pré-inscriptions : store Vercel Blob privé (Paris), relié au projet agmsmed.
# Vercel ajoute BLOB_STORE_ID ; sur Vercel, l'accès passe par le jeton OIDC fourni
# à chaque requête. En local : `vercel env pull .env.local` (ajoute VERCEL_OIDC_TOKEN).
BLOB_STORE_ID=

# Mot de passe de l'espace admin /admin (liste et export des pré-inscriptions).
ADMIN_PASSWORD=

# Optionnel, en local : simuler une autre date d'ouverture des pré-inscriptions.
# PREINSCRIPTION_OPENS_AT=2026-09-01T00:00:00-04:00
